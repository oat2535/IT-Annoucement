# ==============================================================================
# Environment Configuration for IT Announcement System
# ==============================================================================

# 1. Django Debug Mode (0 for Production, 1 for Local Development)
# สำคัญ: บน Production ต้องตั้งค่าเป็น 0 เพื่อความปลอดภัยและไม่ให้เซิร์ฟเวอร์กิน RAM สะสม
DEBUG=0

# 2. Secret Key สำหรับเข้ารหัส Session และ CSRF (ควรเปลี่ยนเป็นค่ายาวๆ สุ่มใหม่บน Production)
SECRET_KEY=change-this-to-a-very-secure-random-string-in-production-1234567890

# 3. โฮสต์หรือไอพีที่อนุญาตให้เข้าใช้งาน (คั่นด้วยเครื่องหมายจุลภาค ,)
# เช่น: ALLOWED_HOSTS=it-announcement.thonglorpet.com,192.168.1.50,localhost
ALLOWED_HOSTS=*

# 4. HTTPS & Reverse Proxy Settings
# เมื่อใช้งานผ่าน HTTPS ให้เปิดเป็น 1 เพื่อเปิดความปลอดภัยสำหรับ Cookie (SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE)
USE_HTTPS=1

# 5. โดเมนที่อนุญาตสำหรับ CSRF เมื่อส่ง Form ผ่าน HTTPS (สำคัญมาก ป้องกัน Error 403 Forbidden)
# ระบุ URL เต็มที่มี https:// เช่น: CSRF_TRUSTED_ORIGINS=https://annouce.thonglorpet.com,https://192.168.1.50:5889
CSRF_TRUSTED_ORIGINS=https://annouce.thonglorpet.com

# 6. บังคับ Redirect จาก HTTP ไปยัง HTTPS ผ่าน Django (หาก Reverse Proxy เช่น Nginx ไม่ได้ทำไว้)
# 0 = ปิด (ให้ Nginx/Proxy จัดการ), 1 = เปิด
SECURE_SSL_REDIRECT=0

# 7. HTTP Strict Transport Security (HSTS) ในหน่วยวินาที (0 = ปิด, 31536000 = 1 ปี)
SECURE_HSTS_SECONDS=0

# 8. พอร์ตภายนอกของ Host ที่จะ Map เข้า Container (Default: 5889)
PORT=5889

# 9. Path ฐานข้อมูล SQLite บน Host (Default: /home/admintlp/it-annoucement-tlp/db.sqlite3)
SQLITE_DB_PATH=/home/admintlp/it-annoucement-tlp/db.sqlite3

# 10. Path สำหรับโฟลเดอร์ Media บน Host (Default: /home/admintlp/it-annoucement-tlp/media)
MEDIA_PATH=/home/admintlp/it-annoucement-tlp/media

# 11. SQLite Journal Mode (DELETE สำหรับ single file host mount ให้ host เห็นข้อมูลทันที, หรือ WAL)
SQLITE_JOURNAL_MODE=DELETE
